[node name="Label" type="Label" parent="ScrollContainer/VBoxContainer/HBoxContainer2" unique_id=400392557]
custom_minimum_size = Vector2(650, 0)
layout_mode = 2
size_flags_vertical = 0
theme_override_colors/font_color = Color(0.101960786, 0.10980392, 0.18039216, 1)
theme_override_fonts/font = ExtResource("3_fhtmy")
text = "На задание можно отправить 1-2 человек.
Чем больше тем лучше, но не забывай что проблема не приходит одна. Отправишь всех людей и не сможешь найти еще сотрудника под следующую задачу. Отправишь одного и он не справится? потерпишь поражение.
Поражение  - Ранение
2 ранения - смерть агента"
autowrap_mode = 2

