theme_override_colors/font_color = Color(0.101960786, 0.10980392, 0.18039216, 1)
theme_override_fonts/font = ExtResource("3_fhtmy")
text = "Задание проходит так, вам предложат 2-3 варианта решения задания, основывясь на характеристиках своего отряда выберите тот что считаете лучшим. Вы не будете знать заранее что вам больше необходимо сила или ловкость, лишь прочитав вариант и подумав логически вы поймете какой вариант для вас успешней. Но не забывайте пока вы думаете проблемы и жалобы поступают. 
Шанс успеха зависит от разницы площадь которую необходимо покрывать характеристиками и площади ваших характеристик."
autowrap_mode = 2

