[node name="Label2" type="Label" parent="ScrollContainer/VBoxContainer" unique_id=2043015370]
clip_contents = true
custom_minimum_size = Vector2(700, 250)
layout_mode = 2
theme_override_colors/font_color = Color(0.10223927, 0.11010014, 0.17997457, 1)
theme_override_fonts/font = ExtResource("3_fhtmy")
text = "[СИСТЕМа ЗаПУЩЕНа]
[ЦЕНТР УПРаВЛЕНИЯ ГОРОДОМ — ONLINE]
Приветствуем, Диспетчер.
Ваша задача защищать город, для этого вам выдается спецотряд людей кто не хочет стоять в трудную минуту. У них есть свои таланты, каждый индивидуален, ваша задача правильно распределять кто и какие задачи будет выполнять в данный момент времени"
autowrap_mode = 2

[node name="VBoxContainer" type="HBoxContainer" parent="ScrollContainer/VBoxContainer" unique_id=1582029449]
layout_mode = 2

[node name="Label" type="Label" parent="ScrollContainer/VBoxContainer/VBoxContainer" unique_id=1578003168]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.101960786, 0.10980392, 0.18039216, 1)
theme_override_fonts/font = ExtResource("3_fhtmy")
text = "Это профиль ваших агентов, в нем вы можете увидеть характеристики агента и его пятиугольник основанный на этих же характеристиках.
Также здесь содержится информация о текущем опыте и необходимом для перехода на следующий уровень.
Характеристики улучшаются по следующим правилам:
Каждый четный уровень выбор за вами куда вложить одно очко характеристик, а каждый нечетный агент сам поймет что ему важнее.
"
autowrap_mode = 2

