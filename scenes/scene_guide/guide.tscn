[node name="Label" type="Label" parent="ScrollContainer/VBoxContainer/HBoxContainer" unique_id=775420384]
custom_minimum_size = Vector2(700, 0)
layout_mode = 2
size_flags_vertical = 0
theme_override_colors/font_color = Color(0.101960786, 0.10980392, 0.18039216, 1)
theme_override_fonts/font = ExtResource("3_fhtmy")
text = "О проблемах люди позвонят в нашу службу, я же буду отправлять тебе вот такие сигналы о том что где-то нужна помощь вашего отряда. Задания будут разного уровня, внимательно читай суть задания. Ведь никто тебе не скажет какие характеристики пригодятся для выполнения тех или иных задач, все в твоих руках"
autowrap_mode = 2

